#!/usr/bin/env bash
#
# minibox - Lightweight rootless Debian GUI container manager for Podman
#
# Description:
#   Manages isolated Debian GUI containers using native rootless Podman mechanisms.
#   Provides pure Wayland display, PipeWire audio, automatic GPU acceleration,
#   and complete home directory isolation.
#

set -euo pipefail

# -----------------------------------------------------------------------------
# Global Constants & Defaults
# -----------------------------------------------------------------------------

readonly MINIBOX_VERSION="1.0.0"
readonly DEFAULT_REGISTRY_BASE="ghcr.io/chiencao2288/debian-box"
readonly PRESET_NORMAL="${DEFAULT_REGISTRY_BASE}:normal"
readonly PRESET_WINE="${DEFAULT_REGISTRY_BASE}:wine"
readonly PRESET_AI="${DEFAULT_REGISTRY_BASE}:ai"

# -----------------------------------------------------------------------------
# Logging Functions
# -----------------------------------------------------------------------------

## Prints informational message to stderr.
## Arguments:
##   $* Message string.
log_info() {
    printf '\033[1;34m[INFO]\033[0m %s\n' "$*" >&2
}

## Prints warning message to stderr.
## Arguments:
##   $* Warning string.
log_warn() {
    printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2
}

## Prints error message to stderr.
## Arguments:
##   $* Error string.
log_error() {
    printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
}

## Prints error message and terminates program.
## Arguments:
##   $* Error message.
die() {
    log_error "$*"
    exit 1
}

# -----------------------------------------------------------------------------
# Storage Path Resolution (Supports MINIBOX_HOME)
# -----------------------------------------------------------------------------

readonly XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly DEFAULT_MINIBOX_DATA_DIR="$XDG_DATA_HOME/minibox"

## Resolves the root data directory for minibox.
## Inspects MINIBOX_HOME environment variable, local .env, and user config.
## Returns:
##   Canonical path to data directory.
resolve_storage_dir() {
    local candidate="${MINIBOX_HOME:-}"

    # Check local .env in current working directory
    if [[ -z "$candidate" && -f "./.env" ]]; then
        candidate="$(grep -E '^[[:space:]]*MINIBOX_HOME=' "./.env" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '"'\'' ' || true)"
    fi

    # Check ~/.config/minibox/config
    if [[ -z "$candidate" && -f "${HOME}/.config/minibox/config" ]]; then
        candidate="$(grep -E '^[[:space:]]*MINIBOX_HOME=' "${HOME}/.config/minibox/config" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '"'\'' ' || true)"
    fi

    if [[ -n "$candidate" ]]; then
        candidate="${candidate/#\~/$HOME}"
        if mkdir -p "$candidate" 2>/dev/null && [[ -w "$candidate" ]]; then
            printf '%s' "$(cd "$candidate" 2>/dev/null && pwd -P)"
            return 0
        else
            log_warn "MINIBOX_HOME='$candidate' is not valid or writable. Falling back to default: $DEFAULT_MINIBOX_DATA_DIR"
        fi
    fi

    mkdir -p "$DEFAULT_MINIBOX_DATA_DIR" 2>/dev/null || true
    printf '%s' "$DEFAULT_MINIBOX_DATA_DIR"
}

MINIBOX_DATA_DIR="$(resolve_storage_dir)"
readonly MINIBOX_DATA_DIR
readonly MINIBOX_BOXES_DIR="$MINIBOX_DATA_DIR/boxes"

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

## Verifies prerequisite binaries and environment constraints.
## Enforces rootless execution, Podman availability, Wayland session, and Fedora host.
## Returns:
##   0 on success, exits 1 on fatal violation.
check_prerequisites() {
    # 1. Enforce rootless execution
    if [[ "$(id -u)" -eq 0 ]]; then
        die "minibox must be executed as a regular user (rootless mode). Do not run with sudo or as root."
    fi

    # 2. Enforce Podman availability
    if ! command -v podman >/dev/null 2>&1; then
        die "Podman not found in PATH. Please install Podman first (Fedora: sudo dnf install podman)."
    fi

    # 3. Check for Wayland session
    if [[ -z "${WAYLAND_DISPLAY:-}" && "${XDG_SESSION_TYPE:-}" != "wayland" ]]; then
        log_warn "Wayland session not detected (XDG_SESSION_TYPE='${XDG_SESSION_TYPE:-unknown}'). minibox requires Wayland for GUI support."
    fi

    # 4. Check for Fedora host
    if [[ -f "/etc/os-release" ]] && ! grep -qi "fedora" /etc/os-release; then
        log_warn "Host OS is not detected as Fedora Linux. minibox is officially engineered and supported for Fedora."
    fi
}

## Sanitizes container username based on box name or user override.
## Strips trailing '-box', lowercases, replaces non-alphanumeric with '_',
## ensures valid starting character, and caps length at 32 characters.
## Arguments:
##   $1 Raw box name or user string.
## Outputs:
##   Sanitized username string.
sanitize_username() {
    local raw="$1"
    raw="${raw%-box}"
    local sanitized
    sanitized="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/_/g')"

    if [[ ! "$sanitized" =~ ^[a-z_] ]]; then
        sanitized="_$sanitized"
    fi

    printf '%s' "${sanitized:0:32}"
}

## Resolves image string from preset keyword or custom image reference.
## Arguments:
##   $1 Image preset ('normal', 'wine', 'ai') or full image reference.
## Outputs:
##   Resolved container image URL.
resolve_image() {
    local input="$1"
    case "$input" in
        normal|default|latest)
            printf '%s' "$PRESET_NORMAL"
            ;;
        wine)
            printf '%s' "$PRESET_WINE"
            ;;
        ai|cuda)
            printf '%s' "$PRESET_AI"
            ;;
        *)
            printf '%s' "$input"
            ;;
    esac
}

## Detects host Wayland display and constructs Podman volume/env arguments.
## Outputs:
##   Array of podman argument strings separated by newlines.
detect_wayland_args() {
    local host_uid
    host_uid="$(id -u)"
    local wayland_socket="${WAYLAND_DISPLAY:-wayland-0}"
    local host_socket_path="${XDG_RUNTIME_DIR:-/run/user/$host_uid}/$wayland_socket"

    if [[ -S "$host_socket_path" ]]; then
        printf '%s\n' "--volume" "$host_socket_path:/run/user/$host_uid/$wayland_socket:z"
        printf '%s\n' "--env" "WAYLAND_DISPLAY=$wayland_socket"
        printf '%s\n' "--env" "XDG_RUNTIME_DIR=/run/user/$host_uid"
    else
        log_warn "Wayland socket not found at '$host_socket_path'. Wayland GUI applications may fail to start."
    fi
}

## Detects host PipeWire socket and constructs Podman volume arguments.
## Outputs:
##   Array of podman argument strings separated by newlines.
detect_pipewire_args() {
    local host_uid
    host_uid="$(id -u)"
    local host_pw_path="${XDG_RUNTIME_DIR:-/run/user/$host_uid}/pipewire-0"

    if [[ -S "$host_pw_path" ]]; then
        printf '%s\n' "--volume" "$host_pw_path:/run/user/$host_uid/pipewire-0:z"
        printf '%s\n' "--env" "PIPEWIRE_RUNTIME_DIR=/run/user/$host_uid"
    fi
}

## Scans host GPU hardware (AMD DRI, KFD, Nvidia CDI) and constructs device arguments.
## Outputs:
##   Array of podman argument strings separated by newlines.
detect_gpu_args() {
    if [[ -d "/dev/dri" ]]; then
        printf '%s\n' "--device" "/dev/dri"
    fi

    if [[ -e "/dev/kfd" ]]; then
        printf '%s\n' "--device" "/dev/kfd"
    fi

    local cdi_found=false
    for cdi_path in /etc/cdi/nvidia.yaml /var/run/cdi/nvidia.yaml /etc/containers/cdi/nvidia.yaml; do
        if [[ -f "$cdi_path" ]]; then
            cdi_found=true
            break
        fi
    done

    if [[ "$cdi_found" == "true" ]]; then
        printf '%s\n' "--device" "nvidia.com/gpu=all"
    fi

    printf '%s\n' "--group-add" "keep-groups"
}


## Checks if container currently exists in Podman.
## Arguments:
##   $1 Box / container name.
## Returns:
##   0 if exists, 1 otherwise.
is_box_exist() {
    local box_name="$1"
    podman container exists "$box_name" 2>/dev/null
}

## Checks if container is running.
## Arguments:
##   $1 Box / container name.
## Returns:
##   0 if running, 1 otherwise.
is_box_running() {
    local box_name="$1"
    local status
    status="$(podman inspect --format '{{.State.Status}}' "$box_name" 2>/dev/null || true)"
    [[ "$status" == "running" ]]
}

## Initializes minimal user shell profile in target home directory if absent.
## Arguments:
##   $1 Absolute path to isolated home directory.
init_home_skeleton() {
    local target_home="$1"
    mkdir -p "$target_home"

    if [[ ! -f "$target_home/.bashrc" ]]; then
        cat <<'EOF' > "$target_home/.bashrc"
# ~/.bashrc for minibox user
if [ -f /etc/bash.bashrc ]; then
    . /etc/bash.bashrc
fi

# Colored prompt with box identity (user@box-name)
PS1='\[\033[01;32m\]\u@\[\033[01;35m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

alias ls='ls --color=auto'
alias ll='ls -la --color=auto'
alias grep='grep --color=auto'

# Auto-deploy gaming Wineprefix if template exists and local prefix is empty
if [ ! -d "$HOME/.wine" ] && [ -d "/opt/default-wineprefix" ]; then
    cp -a /opt/default-wineprefix "$HOME/.wine" 2>/dev/null || true
fi
EOF
    fi

    if [[ ! -f "$target_home/.profile" ]]; then
        cat <<'EOF' > "$target_home/.profile"
# ~/.profile for minibox user
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi
EOF
    fi
}

# -----------------------------------------------------------------------------
# Subcommands
# -----------------------------------------------------------------------------

## Displays CLI usage guide.
cmd_help() {
    cat <<EOF
minibox v${MINIBOX_VERSION} - Rootless Debian GUI container manager for Podman

Usage:
  minibox <command> [options...]

Container Management Commands:
  create <box-name> [options...]   Create a new box
  enter <box-name>                 Launch interactive shell as box user
  run <box-name> <command...>      Execute a command inside box (supports sudo)
  mount <box> <host-path> <dest>   Hot-mount a host directory into running container
  umount <box> <dest>              Unmount hot-mounted directory from container
  cp, copy <src> <dest>            Copy files between host and container
  start <box-name>                 Start box in persistent daemon mode
  stop <box-name>                  Stop a running box
  restart <box-name>               Restart a box
  list, ls                         List all managed boxes and their statuses
  rm <box-name> [--purge]          Remove container (add --purge to delete isolated home)

Diagnostics & Setup Commands:
  gpu-probe                        Probe host GPU acceleration (AMD DRI, KFD, Nvidia CDI)
  provision [preset]               Pull or build container images (normal, wine, ai)
  version                          Show minibox version
  help                             Display this help guide

Creation Options (create):
  --image=<preset|url>             Image preset: normal (default), wine, ai, or custom image URL
  --user=<name>                    Override container username (default: matches host user)
  -v, --volume=<host>:<dest>       Mount custom directory into container (can be repeated)


Environment Variables:
  MINIBOX_HOME                     Custom root storage directory for boxes (default: ~/.local/share/minibox)
Examples:
  minibox create dev-box --image=normal -v /path/on/host:/data
  minibox enter dev-box
  minibox run dev-box sudo apt update
  minibox cp ./file.txt dev-box:/home/chiencao/
  minibox mount dev-box /run/media/chiencao/USB /mnt/usb
  minibox cp dev-box:/home/chiencao/result.png ./
  minibox list
  minibox rm dev-box
EOF
}

## Probes and prints graphics hardware acceleration state on the host system.
cmd_gpu_probe() {
    log_info "Probing graphics hardware (GPU) on host..."
    printf '\n'

    # 1. Direct Rendering Infrastructure (DRI)
    printf '\033[1m[1] Direct Rendering Infrastructure (/dev/dri):\033[0m\n'
    if [[ -d "/dev/dri" ]]; then
        ls -la /dev/dri
    else
        printf '  No /dev/dri detected\n'
    fi
    printf '\n'

    # 2. Kernel Fusion Driver (KFD)
    printf '\033[1m[2] AMD Kernel Fusion Driver (/dev/kfd):\033[0m\n'
    if [[ -e "/dev/kfd" ]]; then
        ls -la /dev/kfd
    else
        printf '  No /dev/kfd detected (AMD compute not enabled or non-AMD GPU)\n'
    fi
    printf '\n'

    # 3. NVIDIA CDI & Driver
    printf '\033[1m[3] NVIDIA Container Device Interface (CDI) configuration:\033[0m\n'
    local cdi_active=false
    for cdi_file in /etc/cdi/nvidia.yaml /var/run/cdi/nvidia.yaml /etc/containers/cdi/nvidia.yaml; do
        if [[ -f "$cdi_file" ]]; then
            printf '  ✓ Found CDI configuration at: %s\n' "$cdi_file"
            cdi_active=true
        fi
    done
    if [[ "$cdi_active" == "false" ]]; then
        printf '  ✕ No nvidia.yaml CDI configuration found (run "nvidia-ctk cdi generate" if needed)\n'
    fi

    if command -v nvidia-smi >/dev/null 2>&1; then
        printf '\n\033[1m[4] nvidia-smi status:\033[0m\n'
        nvidia-smi -L || true
    fi
}

## Pulls or prepares container images for a given preset.
## Arguments:
##   $1 Optional preset name ('normal', 'wine', 'ai').
cmd_provision() {
    local preset="${1:-normal}"
    local target_image
    target_image="$(resolve_image "$preset")"

    log_info "Pulling container image for preset '$preset': $target_image"
    if podman pull "$target_image"; then
        log_info "Image pulled successfully: $target_image"
    else
        log_warn "Failed to pull image from registry '$target_image'."
        log_info "You can build the image locally with Containerfile.$preset using:"
        printf '  podman build -t %s -f Containerfile.%s .\n' "$target_image" "$preset"
    fi
}

## Creates a new minibox container.
## Arguments:
##   $* Command line arguments.
cmd_create() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox create <box-name> [options...]"
    fi

    local box_name="$1"
    shift

    if is_box_exist "$box_name"; then
        die "Box '$box_name' already exists. Please choose a different name or remove the old box."
    fi

    local image_preset="normal"
    local raw_image=""
    local user_override=""
    local -a custom_volumes=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --image=*)
                raw_image="${1#*=}"
                ;;
            --user=*)
                user_override="${1#*=}"
                ;;
            -v|--volume)
                if [[ $# -lt 2 || "$2" == -* ]]; then
                    die "Option $1 requires an argument. Example: -v /host/path:/container/path"
                fi
                custom_volumes+=("$2")
                shift
                ;;
            -v=*|--volume=*)
                custom_volumes+=("${1#*=}")
                ;;
            --home=*|--home)
                die "Option '--home' has been removed. Each box strictly uses its isolated directory at '~/.local/share/minibox/boxes/<box>/home'. Use '-v /host/path:/container/path' to mount extra directories."
                ;;
            --mounts|--mount-drives)
                die "Option '--mounts' has been removed. USB and external drives are not mounted by default. Use '-v /host/path:/container/path' to mount specific paths."
                ;;
            -h|--help)
                cmd_help
                return 0
                ;;
            *)
                die "Invalid option: $1"
                ;;
        esac
        shift
    done

    # Resolve target image
    local final_image
    if [[ -n "$raw_image" ]]; then
        final_image="$(resolve_image "$raw_image")"
        image_preset="$raw_image"
    else
        final_image="$PRESET_NORMAL"
        image_preset="normal"
    fi

    # Resolve target username (defaults 1:1 with host user)
    local target_user
    if [[ -n "$user_override" ]]; then
        target_user="$(sanitize_username "$user_override")"
    else
        target_user="$(sanitize_username "${USER:-$(id -un)}")"
    fi

    if [[ -z "$target_user" ]]; then
        target_user="minibox"
    fi

    # Resolve isolated home path (strictly isolated, no host pollution)
    local target_home="$MINIBOX_BOXES_DIR/$box_name/home"

    local host_uid host_gid
    host_uid="$(id -u)"
    host_gid="$(id -g)"

    log_info "Initializing box '$box_name'..."
    log_info "  - User:      $target_user (UID: $host_uid, GID: $host_gid)"
    log_info "  - Home:      $target_home"
    log_info "  - Image:     $final_image ($image_preset)"
    if [[ ${#custom_volumes[@]} -gt 0 ]]; then
        log_info "  - Volumes:   ${custom_volumes[*]}"
    fi

    # Prepare home directory and shell skeleton
    init_home_skeleton "$target_home"

    # Check image availability
    if ! podman image exists "$final_image" 2>/dev/null; then
        log_info "Image '$final_image' not found locally, pulling..."
        if ! podman pull "$final_image"; then
            log_warn "Failed to pull image from registry. Check local image or build via Containerfile."
        fi
    fi

    # Build dynamic arguments
    local -a wayland_args=()
    mapfile -t wayland_args < <(detect_wayland_args)

    local -a pipewire_args=()
    mapfile -t pipewire_args < <(detect_pipewire_args)

    local -a gpu_args=()
    mapfile -t gpu_args < <(detect_gpu_args)

    local -a volume_args=()
    for vol in "${custom_volumes[@]}"; do
        volume_args+=("--volume" "$vol")
    done

    # Run native Podman create command
    podman create \
        --name "$box_name" \
        --hostname "$box_name" \
        --add-host "$box_name:127.0.0.1" \
        --init \
        --label "minibox=true" \
        --label "minibox.name=$box_name" \
        --label "minibox.user=$target_user" \
        --label "minibox.home=$target_home" \
        --label "minibox.preset=$image_preset" \
        --label "minibox.image=$final_image" \
        --security-opt label=disable \
        --ipc=host \
        --net=host \
        --userns=keep-id \
        --passwd-entry="$target_user:x:$host_uid:$host_gid:$target_user:/home/$target_user:/bin/bash" \
        --group-entry="$target_user:x:$host_gid:" \
        --workdir "/home/$target_user" \
        --volume "$target_home:/home/$target_user:U,z" \
        "${wayland_args[@]}" \
        "${pipewire_args[@]}" \
        "${gpu_args[@]}" \
        "${volume_args[@]}" \
        "$final_image" \
        sleep infinity >/dev/null
    # Deploy pre-configured gaming Wineprefix if provided by the container image
    if [[ ! -d "$target_home/.wine" ]]; then
        if podman cp "$box_name:/opt/default-wineprefix" "$target_home/.wine" 2>/dev/null; then
            log_info "Pre-configured gaming Wineprefix deployed (Visual C++ 2005-2022, .NET, DXVK)."
        fi
    fi


    # Persist metadata for standalone inspection
    local meta_dir="$MINIBOX_BOXES_DIR/$box_name"
    mkdir -p "$meta_dir"
    cat <<EOF > "$meta_dir/config.env"
BOX_NAME="$box_name"
CONTAINER_USER="$target_user"
BOX_HOME="$target_home"
IMAGE="$final_image"
PRESET="$image_preset"
VOLUMES="${custom_volumes[*]:-none}"
CREATED_AT="$(date -Iseconds)"
EOF

    log_info "Box '$box_name' created successfully! Run 'minibox enter $box_name' to start using it."
}

## Starts an existing stopped container.
## Arguments:
##   $1 Box name.
cmd_start() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox start <box-name>"
    fi
    local box_name="$1"

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if is_box_running "$box_name"; then
        log_info "Box '$box_name' is already running."
        return 0
    fi

    log_info "Starting box '$box_name'..."
    podman start "$box_name" >/dev/null
    log_info "Box '$box_name' is ready."
}

## Stops a running container.
## Arguments:
##   $1 Box name.
cmd_stop() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox stop <box-name>"
    fi
    local box_name="$1"

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        log_info "Box '$box_name' is already stopped."
        return 0
    fi

    log_info "Stopping box '$box_name'..."
    podman stop -t 2 "$box_name" >/dev/null
    log_info "Box '$box_name' stopped."
}

## Restarts a container.
## Arguments:
##   $1 Box name.
cmd_restart() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox restart <box-name>"
    fi
    local box_name="$1"

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    log_info "Restarting box '$box_name'..."
    podman restart -t 2 "$box_name" >/dev/null
    log_info "Box '$box_name' restarted."
}

## Enters container interactive shell as unprivileged container user.
## Arguments:
##   $1 Box name.
cmd_enter() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox enter <box-name>"
    fi
    local box_name="$1"
    shift

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        cmd_start "$box_name"
    fi

    local target_user
    target_user="$(podman inspect --format '{{index .Config.Labels "minibox.user"}}' "$box_name" 2>/dev/null || true)"
    if [[ -z "$target_user" ]]; then
        target_user="$(sanitize_username "$box_name")"
    fi

    local host_uid
    host_uid="$(id -u)"

    local -a it_flag=("-i")
    if [[ -t 0 && -t 1 ]]; then
        it_flag+=("-t")
    fi

    exec podman exec "${it_flag[@]}" \
        --user="$target_user" \
        -e HOME="/home/$target_user" \
        -e USER="$target_user" \
        -e WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
        -e XDG_RUNTIME_DIR="/run/user/$host_uid" \
        -e PIPEWIRE_RUNTIME_DIR="/run/user/$host_uid" \
        -e TERM="${TERM:-xterm-256color}" \
        "$box_name" /bin/bash --login
}

## Executes command inside container as unprivileged container user (supports sudo).
## Arguments:
##   $1 Box name.
##   $2.. Command arguments.
cmd_run() {
    if [[ $# -lt 2 ]]; then
        die "Missing command. Usage: minibox run <box-name> <command...> (or use 'minibox enter <box-name>' for interactive shell)"
    fi
    local box_name="$1"
    shift

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        cmd_start "$box_name"
    fi

    local target_user
    target_user="$(podman inspect --format '{{index .Config.Labels "minibox.user"}}' "$box_name" 2>/dev/null || true)"
    if [[ -z "$target_user" ]]; then
        target_user="$(sanitize_username "$box_name")"
    fi

    local host_uid
    host_uid="$(id -u)"

    local -a it_flag=("-i")
    if [[ -t 0 && -t 1 ]]; then
        it_flag+=("-t")
    fi

    exec podman exec "${it_flag[@]}" \
        --user="$target_user" \
        -e HOME="/home/$target_user" \
        -e USER="$target_user" \
        -e WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
        -e XDG_RUNTIME_DIR="/run/user/$host_uid" \
        -e PIPEWIRE_RUNTIME_DIR="/run/user/$host_uid" \
        -e TERM="${TERM:-xterm-256color}" \
        "$box_name" "$@"
}

## Copies files/directories between host and container.
## Arguments:
##   $* cp arguments.
cmd_cp() {
    if [[ $# -lt 2 ]]; then
        cat <<'EOF' >&2
Error: Missing arguments for cp.
Usage:
  minibox cp <src> <dest>
  minibox cp in <box-name> <host-path> <container-path>
  minibox cp out <box-name> <container-path> <host-path>

Examples:
  # Copy file from host into container:
  minibox cp ./model.bin my-box:/home/chiencao/
  minibox cp in my-box ./model.bin /home/chiencao/

  # Copy file from container to host:
  minibox cp my-box:/home/chiencao/output.png ./
  minibox cp out my-box /home/chiencao/output.png ./
EOF
        exit 1
    fi

    local src=""
    local dest=""

    if [[ "$1" == "in" ]]; then
        if [[ $# -ne 4 ]]; then
            die "Usage: minibox cp in <box-name> <host-path> <container-path>"
        fi
        local box="$2"
        local host_path="$3"
        local container_path="$4"
        src="$host_path"
        dest="$box:$container_path"
    elif [[ "$1" == "out" ]]; then
        if [[ $# -ne 4 ]]; then
            die "Usage: minibox cp out <box-name> <container-path> <host-path>"
        fi
        local box="$2"
        local container_path="$3"
        local host_path="$4"
        src="$box:$container_path"
        dest="$host_path"
    elif [[ $# -eq 3 ]]; then
        local box="$1"
        if is_box_exist "$box"; then
            if [[ -e "$2" ]]; then
                src="$2"
                dest="$box:$3"
            else
                src="$box:$2"
                dest="$3"
            fi
        else
            die "Box '$box' not found. Usage: minibox cp <src> <dest>"
        fi
    elif [[ $# -eq 2 ]]; then
        src="$1"
        dest="$2"
    else
        die "Invalid arguments. Usage: minibox cp <src> <dest>"
    fi

    if [[ "$src" =~ ^([^:]+):(.*)$ ]]; then
        local box_check="${BASH_REMATCH[1]}"
        if ! is_box_exist "$box_check"; then
            die "Box '$box_check' does not exist."
        fi
    fi
    if [[ "$dest" =~ ^([^:]+):(.*)$ ]]; then
        local box_check="${BASH_REMATCH[1]}"
        if ! is_box_exist "$box_check"; then
            die "Box '$box_check' does not exist."
        fi
    fi

    log_info "Copying '$src' -> '$dest'..."
    podman cp "$src" "$dest"
    log_info "Copy completed successfully."
}

## Hot-mounts a host directory into a running container's mount namespace.
## Arguments:
##   $1 Box name.
##   $2 Host path.
##   $3 Container target path.
cmd_mount() {
    if [[ $# -lt 3 ]]; then
        die "Usage: minibox mount <box-name> <host-path> <container-target-path>"
    fi
    local box_name="$1"
    local raw_host_path="$2"
    local container_path="$3"

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        log_info "Box '$box_name' is not running. Starting box..."
        cmd_start "$box_name"
    fi

    if [[ ! -e "$raw_host_path" ]]; then
        die "Host path '$raw_host_path' does not exist."
    fi

    local host_path
    host_path="$(realpath "$raw_host_path")"

    local pid
    pid="$(podman inspect "$box_name" --format '{{.State.Pid}}' 2>/dev/null || true)"
    if [[ -z "$pid" || "$pid" -le 0 ]]; then
        die "Failed to determine process PID for box '$box_name'."
    fi

    # Ensure target directory exists inside container
    podman exec -u root "$box_name" mkdir -p "$container_path"

    log_info "Hot-mounting '$host_path' -> '$box_name:$container_path'..."
    if ! podman unshare python3 - "$host_path" "$container_path" "$pid" <<'PYEOF'
import os, sys, ctypes

SYS_open_tree = 428
SYS_move_mount = 429
OPEN_TREE_CLONE = 1
MOVE_MOUNT_F_EMPTY_PATH = 4
CLONE_NEWNS = 0x00020000

host_path = sys.argv[1].encode('utf-8')
target_path = sys.argv[2].encode('utf-8')
pid = sys.argv[3]

libc = ctypes.CDLL("libc.so.6", use_errno=True)

# 1. Open mount tree from host
tree_fd = libc.syscall(SYS_open_tree, -100, host_path, OPEN_TREE_CLONE)
if tree_fd < 0:
    errno = ctypes.get_errno()
    sys.stderr.write(f"open_tree failed ({errno}): {os.strerror(errno)}\n")
    sys.exit(1)

# 2. Open container mount namespace
try:
    ns_fd = os.open(f"/proc/{pid}/ns/mnt", os.O_RDONLY)
except Exception as e:
    sys.stderr.write(f"Cannot access container mount namespace: {e}\n")
    sys.exit(1)

# 3. Enter container mount namespace
if libc.setns(ns_fd, CLONE_NEWNS) != 0:
    errno = ctypes.get_errno()
    sys.stderr.write(f"setns failed ({errno}): {os.strerror(errno)}\n")
    sys.exit(1)

# 4. Attach cloned mount tree to target path in container
if libc.syscall(SYS_move_mount, tree_fd, b"", -100, target_path, MOVE_MOUNT_F_EMPTY_PATH) != 0:
    errno = ctypes.get_errno()
    sys.stderr.write(f"move_mount failed ({errno}): {os.strerror(errno)}\n")
    sys.exit(1)
PYEOF
    then
        die "Failed to hot-mount '$host_path' into container."
    fi

    log_info "Successfully hot-mounted '$host_path' to '$box_name:$container_path'."
}

## Unmounts a hot-mounted directory from a running container.
## Arguments:
##   $1 Box name.
##   $2 Container path.
cmd_umount() {
    if [[ $# -lt 2 ]]; then
        die "Usage: minibox umount <box-name> <container-path>"
    fi
    local box_name="$1"
    local container_path="$2"

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        log_info "Box '$box_name' is not running (mounts are already released)."
        return 0
    fi

    local pid
    pid="$(podman inspect "$box_name" --format '{{.State.Pid}}' 2>/dev/null || true)"
    if [[ -z "$pid" || "$pid" -le 0 ]]; then
        die "Failed to determine process PID for box '$box_name'."
    fi

    log_info "Unmounting '$box_name:$container_path'..."
    if ! podman unshare python3 - "$container_path" "$pid" <<'PYEOF'
import os, sys, ctypes

CLONE_NEWNS = 0x00020000
MNT_DETACH = 2

target_path = sys.argv[1].encode('utf-8')
pid = sys.argv[2]

libc = ctypes.CDLL("libc.so.6", use_errno=True)

try:
    ns_fd = os.open(f"/proc/{pid}/ns/mnt", os.O_RDONLY)
except Exception as e:
    sys.stderr.write(f"Cannot access container mount namespace: {e}\n")
    sys.exit(1)

if libc.setns(ns_fd, CLONE_NEWNS) != 0:
    errno = ctypes.get_errno()
    sys.stderr.write(f"setns failed ({errno}): {os.strerror(errno)}\n")
    sys.exit(1)

if libc.umount2(target_path, MNT_DETACH) != 0:
    errno = ctypes.get_errno()
    sys.stderr.write(f"umount failed ({errno}): {os.strerror(errno)}\n")
    sys.exit(1)
PYEOF
    then
        die "Failed to unmount '$container_path' from container."
    fi

    log_info "Successfully unmounted '$box_name:$container_path'."
}

## Enters container shell or executes command as root.
## Arguments:
##   $1 Box name.
##   $2.. Command arguments (optional).
cmd_root() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox root <box-name> [command...]"
    fi
    local box_name="$1"
    shift

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    if ! is_box_running "$box_name"; then
        cmd_start "$box_name"
    fi

    local -a it_flag=("-i")
    if [[ -t 0 && -t 1 ]]; then
        it_flag+=("-t")
    fi

    if [[ $# -eq 0 ]]; then
        exec podman exec "${it_flag[@]}" \
            --user=root \
            -e TERM="${TERM:-xterm-256color}" \
            "$box_name" /bin/bash --login
    else
        exec podman exec "${it_flag[@]}" \
            --user=root \
            -e TERM="${TERM:-xterm-256color}" \
            "$box_name" "$@"
    fi
}

## Lists all managed minibox containers and their status.
cmd_list() {
    local -a boxes
    mapfile -t boxes < <(podman ps -a --filter "label=minibox=true" --format "{{.Names}}" 2>/dev/null || true)

    if [[ ${#boxes[@]} -eq 0 ]]; then
        log_info "No boxes found. Create your first box using: minibox create <box-name>"
        return 0
    fi

    printf '%-18s %-12s %-12s %-10s %s\n' "BOX NAME" "STATUS" "USER" "PRESET" "HOME DIRECTORY"
    printf '%-18s %-12s %-12s %-10s %s\n' "--------" "------" "----" "------" "--------------"

    for box in "${boxes[@]}"; do
        local status user preset home
        status="$(podman inspect --format '{{.State.Status}}' "$box" 2>/dev/null || echo "unknown")"
        user="$(podman inspect --format '{{index .Config.Labels "minibox.user"}}' "$box" 2>/dev/null || echo "-")"
        preset="$(podman inspect --format '{{index .Config.Labels "minibox.preset"}}' "$box" 2>/dev/null || echo "custom")"
        home="$(podman inspect --format '{{index .Config.Labels "minibox.home"}}' "$box" 2>/dev/null || echo "-")"

        printf '%-18s %-12s %-12s %-10s %s\n' "$box" "$status" "$user" "$preset" "$home"
    done
}

## Removes a container, optionally purging its isolated home folder.
## Arguments:
##   $* Command line arguments.
cmd_rm() {
    if [[ $# -lt 1 ]]; then
        die "Missing box name. Usage: minibox rm <box-name> [--purge]"
    fi

    local box_name="$1"
    shift

    local purge_home=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge|--purge-home)
                purge_home=true
                ;;
            *)
                die "Invalid option: $1"
                ;;
        esac
        shift
    done

    if ! is_box_exist "$box_name"; then
        die "Box '$box_name' does not exist."
    fi

    local target_home
    target_home="$(podman inspect --format '{{index .Config.Labels "minibox.home"}}' "$box_name" 2>/dev/null || true)"
    if [[ -z "$target_home" ]]; then
        target_home="$MINIBOX_BOXES_DIR/$box_name/home"
    fi

    if is_box_running "$box_name"; then
        log_info "Stopping container '$box_name' before removal..."
        podman stop -t 2 "$box_name" >/dev/null 2>&1 || true
    fi

    log_info "Removing container '$box_name' from Podman..."
    podman rm -f "$box_name" >/dev/null

    # Clean metadata directory
    local meta_dir="$MINIBOX_BOXES_DIR/$box_name"
    if [[ -f "$meta_dir/config.env" ]]; then
        rm -f "$meta_dir/config.env"
    fi

    if [[ "$purge_home" == "true" ]]; then
        if [[ -d "$target_home" ]]; then
            log_warn "--purge flag specified. Deleting home directory data: $target_home"
            rm -rf "$target_home"
        fi
        rm -rf "$meta_dir"
        log_info "Successfully removed box '$box_name' and its home directory."
    else
        log_info "Successfully removed container '$box_name'."
        log_info "Home directory preserved at: $target_home"
        log_info "(Use 'minibox rm $box_name --purge' to permanently delete home data)."
    fi
}

# -----------------------------------------------------------------------------
# Main Entrypoint
# -----------------------------------------------------------------------------

main() {
    check_prerequisites

    if [[ $# -lt 1 ]]; then
        cmd_help
        exit 0
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        create)
            cmd_create "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        enter)
            cmd_enter "$@"
            ;;
        run|exec)
            cmd_run "$@"
            ;;
        shell)
            die "The 'shell' command has been removed. Use 'minibox enter <box-name>' for an interactive shell, or 'minibox run <box-name> <command>' to execute a command."
            ;;
        cp|copy)
            cmd_cp "$@"
            ;;
        mount)
            cmd_mount "$@"
            ;;
        umount|unmount)
            cmd_umount "$@"
            ;;
        root)
            cmd_root "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        rm|delete)
            cmd_rm "$@"
            ;;
        gpu-probe)
            cmd_gpu_probe "$@"
            ;;
        provision|build)
            cmd_provision "$@"
            ;;
        version|-v|--version)
            printf 'minibox version %s\n' "$MINIBOX_VERSION"
            ;;
        help|-h|--help)
            cmd_help
            ;;
        *)
            die "Unsupported command '$subcommand'. Run 'minibox help' to view available commands."
            ;;
    esac
}

main "$@"
